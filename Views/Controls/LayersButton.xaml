<UserControl x:Class="Cad2Bim.Views.Controls.LayersButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <!-- Square ribbon button: icon placeholder over the "Layers" caption. -->
        <ToggleButton x:Name="PART_Toggle"
                      Style="{StaticResource RibbonToggleButton}"
                      Tag="Layers"
                      ToolTip="Show or hide drawing layers"
                      PreviewMouseLeftButtonDown="OnTogglePreviewMouseDown"
                      Content="{StaticResource IconLayers}"/>

        <!-- Word-style flyout: drops directly under the button, closes on outside click. -->
        <Popup x:Name="PART_Popup"
               PlacementTarget="{Binding ElementName=PART_Toggle}"
               Placement="Bottom"
               VerticalOffset="2"
               HorizontalOffset="0"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               IsOpen="{Binding IsChecked, ElementName=PART_Toggle, Mode=TwoWay}"
               Closed="OnPopupClosed">
            <Border Background="{StaticResource FlyoutBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="2"
                    MinWidth="180"
                    Padding="0,6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.5" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="LAYERS"
                               Style="{StaticResource SectionHeader}"
                               Margin="10,0,10,4"/>
                    <Border Style="{StaticResource SectionRule}" Margin="10,0,10,4"/>

                    <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}"
                                  HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Tickbox first, then the name: both flush left. -->
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsVisible}"
                                          HorizontalAlignment="Left"
                                          Padding="0"
                                          Margin="10,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
