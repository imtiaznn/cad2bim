<UserControl x:Class="Cad2Bim.Views.Controls.ManualPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Cad2Bim.Views.Controls"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             Width="270">
    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0">
        <StackPanel Margin="10">
            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                <TextBlock Text="Manual segmentation" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <Button Style="{StaticResource PanelCloseButton}"
                        Command="{Binding ClosePanelCommand}"
                        ToolTip="Close panel (Esc)"
                        DockPanel.Dock="Right" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="Pick a tool, then click or drag across lines in the drawing. Ctrl+Z undoes a stroke."
                       Foreground="{StaticResource TextDimBrush}"
                       FontSize="11" Margin="0,0,0,2" TextWrapping="Wrap"/>

            <TextBlock Text="TOOL" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionRule}"/>
            <StackPanel Orientation="Horizontal">
                <ToggleButton Style="{StaticResource RibbonToggleButton}" Tag="Brush"
                              Content="{StaticResource IconBrush}"
                              IsChecked="{Binding ManualTool.IsBrushActive}"
                              ToolTip="Paint lines onto the target layer"/>
                <ToggleButton Style="{StaticResource RibbonToggleButton}" Tag="Eraser" Margin="8,0,0,0"
                              Content="{StaticResource IconEraser}"
                              IsChecked="{Binding ManualTool.IsEraserActive}"
                              ToolTip="Paint lines to remove their classification"/>
            </StackPanel>

            <TextBlock Text="TARGET LAYER" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionRule}"/>
            <controls:SegmentedSelector SelectedIndex="{Binding ManualTool.TargetLayerIndex}"
                                        SegmentWidth="78"
                                        HorizontalAlignment="Left"
                                        IsEnabled="{Binding ManualTool.IsBrushActive}">
                <controls:SegmentedSelector.Style>
                    <Style TargetType="controls:SegmentedSelector">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </controls:SegmentedSelector.Style>
                <controls:SegmentedSelector.ItemsSource>
                    <x:Array Type="{x:Type sys:String}">
                        <sys:String>Walls</sys:String>
                        <sys:String>Doors</sys:String>
                        <sys:String>Windows</sys:String>
                    </x:Array>
                </controls:SegmentedSelector.ItemsSource>
            </controls:SegmentedSelector>

            <TextBlock Foreground="{StaticResource TextDimBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="The eraser ignores the target layer and clears whatever it touches."/>
        </StackPanel>
    </Border>
</UserControl>
