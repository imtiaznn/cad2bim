<Window x:Class="Cad2Bim.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cad2Bim.Views.Controls"
        xmlns:rendering="clr-namespace:Cad2Bim.Views.Rendering"
        xmlns:vm="clr-namespace:Cad2Bim.ViewModels"
        Title="Cad2Bim Debug Viewer" Width="1100" Height="700"
        Background="{StaticResource WindowBrush}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ClosePanelCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
    </Window.InputBindings>
    <DockPanel>

        <!-- Top bar: file commands on the left, ribbon tools on the right -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <!-- LastChildFill off: every tool docks to an edge, nothing claims the gap. -->
            <DockPanel LastChildFill="False">
                <Button Command="{Binding OpenFileCommand}"
                        Style="{StaticResource RibbonButton}"
                        Content="{StaticResource IconFile}"
                        Tag="Open"
                        ToolTip="Open a DWG or DXF drawing"
                        DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <controls:SegmentButton DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center"
                                        AutomaticCommand="{Binding ShowAutomaticPanelCommand}"
                                        ManualCommand="{Binding ShowManualPanelCommand}"/>
                <controls:LayersButton ItemsSource="{Binding Layers}" DockPanel.Dock="Right"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- Right: one segmentation panel at a time, collapsed when closed. -->
        <controls:AutomaticPanel DockPanel.Dock="Right">
            <controls:AutomaticPanel.Style>
                <Style TargetType="controls:AutomaticPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActivePanel}" Value="{x:Static vm:SegmentPanel.Automatic}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:AutomaticPanel.Style>
        </controls:AutomaticPanel>
        <controls:ManualPanel DockPanel.Dock="Right">
            <controls:ManualPanel.Style>
                <Style TargetType="controls:ManualPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActivePanel}" Value="{x:Static vm:SegmentPanel.Manual}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:ManualPanel.Style>
        </controls:ManualPanel>

        <!-- Center: CAD viewport -->
        <rendering:CadViewport Model="{Binding Model}"
                               LayersSource="{Binding Layers}"
                               ContentBounds="{Binding Bounds}"
                               Tool="{Binding ManualTool}"/>

    </DockPanel>
</Window>
