<!-- Ribbon icon placeholders, drawn on a 24x24 grid.
     x:Shared="False" hands out a fresh visual per lookup, so one key can sit in
     several buttons. Swap a Viewbox body for a real glyph without touching the views. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Viewbox x:Key="IconLayers" x:Shared="False" Width="22" Height="22">
        <Canvas Width="24" Height="24">
            <Path Data="M12,3 L22,8.5 L12,14 L2,8.5 Z"
                  Stroke="{StaticResource TextBrush}" StrokeThickness="1.5"
                  StrokeLineJoin="Round" Fill="Transparent"/>
            <Path Data="M4,12 L12,16.4 L20,12"
                  Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.5"
                  StrokeLineJoin="Round"/>
            <Path Data="M4,15.6 L12,20 L20,15.6"
                  Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.5"
                  StrokeLineJoin="Round"/>
        </Canvas>
    </Viewbox>

    <!-- Polyline with node handles: line work being picked into segments. -->
    <Viewbox x:Key="IconSegment" x:Shared="False" Width="22" Height="22">
        <Canvas Width="24" Height="24">
            <Path Data="M3,20 L9,9 L15,14 L21,5"
                  Stroke="{StaticResource TextBrush}" StrokeThickness="1.5"
                  StrokeLineJoin="Round"/>
            <Path Data="M1.5,18.5 h3 v3 h-3 Z M7.5,7.5 h3 v3 h-3 Z M13.5,12.5 h3 v3 h-3 Z M19.5,3.5 h3 v3 h-3 Z"
                  Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.2"
                  Fill="Transparent"/>
        </Canvas>
    </Viewbox>

    <!-- Paint brush sweeping to the lower left. -->
    <Viewbox x:Key="IconBrush" x:Shared="False" Width="22" Height="22">
        <Canvas Width="24" Height="24">
            <Path Data="M14.5,3 L21,9.5 L16,14.5 L9.5,8 Z"
                  Stroke="{StaticResource TextBrush}" StrokeThickness="1.5"
                  StrokeLineJoin="Round" Fill="Transparent"/>
            <Path Data="M9.5,8 C7,11 5,15 3.5,20.5 C9,19 13,17 16,14.5"
                  Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.5"
                  StrokeLineJoin="Round"/>
        </Canvas>
    </Viewbox>

    <!-- Tilted eraser block over a baseline. -->
    <Viewbox x:Key="IconEraser" x:Shared="False" Width="22" Height="22">
        <Canvas Width="24" Height="24">
            <Path Data="M4,15 L13,4 L20,10 L11,21 L6,21 Z"
                  Stroke="{StaticResource TextBrush}" StrokeThickness="1.5"
                  StrokeLineJoin="Round" Fill="Transparent"/>
            <Path Data="M8.5,9.5 L15.5,15.5"
                  Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.5"/>
            <Path Data="M13,21 L21,21"
                  Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
    </Viewbox>

    <!-- Sheet with a folded corner. -->
    <Viewbox x:Key="IconFile" x:Shared="False" Width="22" Height="22">
        <Canvas Width="24" Height="24">
            <Path Data="M6,2.5 L14.5,2.5 L19,7 L19,21.5 L6,21.5 Z"
                  Stroke="{StaticResource TextBrush}" StrokeThickness="1.5"
                  StrokeLineJoin="Round" Fill="Transparent"/>
            <Path Data="M14.5,2.5 L14.5,7 L19,7"
                  Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.5"
                  StrokeLineJoin="Round"/>
            <Path Data="M9,12 L16,12 M9,15.5 L16,15.5 M9,19 L13,19"
                  Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
    </Viewbox>

</ResourceDictionary>
