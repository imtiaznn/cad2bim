<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Cad2Bim.Views.Controls">

    <!-- Theme dictionaries are resolved before Application.Resources, so the palette is
         merged here too rather than relied on from the app scope. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/Palette.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Autodesk-style dark scrub field -->
    <Style TargetType="{x:Type controls:NumericScrubBox}">
        <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NumericScrubBox}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <Grid>
                            <!-- Progress fill: scaled from the left by Value's position in its
                                 range, so it costs a transform rather than a layout pass. -->
                            <Border x:Name="Fill"
                                    Background="{StaticResource ScrubFillBrush}"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="1"
                                    RenderTransformOrigin="0,0">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding FillFraction, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Border.RenderTransform>
                            </Border>

                            <DockPanel x:Name="PART_Display" Background="Transparent" Margin="8,4">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="{TemplateBinding Label}"
                                           Foreground="{StaticResource TextLabelBrush}"/>
                                <TextBlock x:Name="PART_ValueText"
                                           HorizontalAlignment="Right"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextStrongBrush}"/>
                            </DockPanel>
                            <TextBox x:Name="PART_Editor"
                                     Visibility="Collapsed"
                                     Margin="8,4"
                                     HorizontalAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     Background="{StaticResource EditorBrush}"
                                     Foreground="{StaticResource TextStrongBrush}"
                                     CaretBrush="{StaticResource TextStrongBrush}"
                                     SelectionBrush="{StaticResource AccentBrush}"
                                     BorderThickness="0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
