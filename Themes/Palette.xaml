<!-- Single source of truth for the Autodesk-style dark palette.
     Every other dictionary and view pulls its colours from here. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBrush" Color="#FF2E2E2E"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF252525"/>
    <SolidColorBrush x:Key="FlyoutBrush" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="EditorBrush" Color="#FF2A2A2A"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="TextStrongBrush" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="TextLabelBrush" Color="#FFB0B0B0"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#FF4A4A4A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0696D7"/>

    <!-- Controls ("Open" button chrome; reused by checkbox + ribbon button) -->
    <SolidColorBrush x:Key="ControlBrush" Color="#FF3B3B3B"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF525252"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FF474747"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#FF2F2F2F"/>

    <!-- Segmented picker: the thumb that slides onto the selected option. -->
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FF5C5C5C"/>

    <!-- Scrub field progress fill: the accent, dropped to a tint so the value stays readable. -->
    <SolidColorBrush x:Key="ScrubFillBrush" Color="#0696D7" Opacity="0.38"/>

    <!-- Checkbox: light-grey outline, hollow fill, white glyph -->
    <SolidColorBrush x:Key="CheckBoxOutlineBrush" Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="CheckBoxGlyphBrush" Color="#FFFFFFFF"/>

</ResourceDictionary>
